        },
        {
          "name": "Remove Item from Playlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/windows/1/playlist/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "windows", "1", "playlist", "1"]
