    },
    {
      "name": "Synchronization",
      "item": [
        {
          "name": "Start Synchronization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaId\": 2,\n  \"duration\": 20\n}"
